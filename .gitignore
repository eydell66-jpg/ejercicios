
ini
# Ignorar el núcleo de WordPress por completo
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/xmlrpc.php
/readme.html
/license.txt

# Ignorar archivos de configuración del servidor y de Git
.htaccess
wp-config.php
.DS_Store
Thumbs.db

# Ignorar las subidas de medios (imágenes, PDFs, etc.)
/wp-content/uploads/
/wp-content/blogs.dir/
/wp-content/upgrade/
/wp-content/backup-*/

# Ignorar temas y plugins por defecto (opcional, actívalo si no los usas)
/wp-content/themes/twentytwentyfour/
/wp-content/themes/twentytwentyfive/
/wp-content/themes/twetytwentythree/
/wp-content/themes/twentytwentytwo/
/wp-content/themes/twentytwentyone/

# Ignorar archivos de entorno y logs
*.log
.env